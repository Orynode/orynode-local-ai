{
  "name": "orynode-local-ai",
  "version": "0.2.0",
  "private": true,
  "description": "Orynode Local AI — open-source, local-first AI assistant for Apple Silicon Macs",
  "author": "Orynode",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "local": "node scripts/start-local.mjs",
    "data:start": "node --disable-warning=ExperimentalWarning scripts/local-data-service.mjs",
    "setup": "bash scripts/install-model.sh",
    "turbo:install": "bash scripts/install-turbo.sh",
    "turbo:start": "bash scripts/start-turbo.sh",
    "turbo:restart": "bash scripts/restart-turbo.sh",
    "model:install": "bash scripts/install-model.sh",
    "model:progress": "node scripts/model-progress.mjs",
    "model:reset": "bash scripts/reset-model.sh",
    "doctor": "bash scripts/doctor.sh",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .orynode"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "next": "^16.2.12",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
