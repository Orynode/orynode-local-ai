{
  "name": "orynode-local-ai",
  "version": "1.1.0",
  "private": true,
  "description": "Orynode Local AI — open-source, local-first AI assistant for Apple Silicon Macs",
  "author": "Orynode",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "local": "node scripts/start-local.mjs",
    "data:start": "node --disable-warning=ExperimentalWarning scripts/local-data-service.mjs",
    "setup": "bash scripts/install-model.sh && bash scripts/install-ocr-helper.sh",
    "ocr:install": "bash scripts/install-ocr-helper.sh",
    "ocr:bench": "tsx scripts/benchmark-ocr.mjs",
    "turbo:install": "bash scripts/install-turbo.sh",
    "turbo:start": "bash scripts/start-turbo.sh",
    "turbo:restart": "bash scripts/restart-turbo.sh",
    "model:install": "bash scripts/install-model.sh",
    "model:progress": "node scripts/model-progress.mjs",
    "model:reset": "bash scripts/reset-model.sh",
    "embedding:install": "node --import tsx scripts/install-embedding-artifact.mjs",
    "doctor": "bash scripts/doctor.sh",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "tsx --test tests/knowledge/*.test.ts tests/chat/*.test.ts tests/data-service/*.test.mjs tests/platform/*.test.mjs tests/platform/*.test.ts",
    "test:knowledge": "tsx --test tests/knowledge/*.test.ts tests/chat/*.test.ts",
    "test:retrieval-eval": "node --import tsx scripts/knowledge/run-retrieval-eval.ts --json .orynode/eval/latest.json --md .orynode/eval/latest.md",
    "knowledge:benchmark-embedding": "node --import tsx scripts/knowledge/benchmark-embedding-artifacts.ts --dry-run",
    "test:contracts": "tsx --test tests/platform/contracts.test.mjs tests/knowledge/phase5-adapters.test.ts",
    "test:smoke-runtime": "node scripts/smoke-runtime.mjs",
    "knowledge:export": "node --disable-warning=ExperimentalWarning scripts/data-service/export-knowledge.mjs",
    "knowledge:import": "node --disable-warning=ExperimentalWarning scripts/data-service/import-knowledge.mjs",
    "knowledge:benchmark-vector": "node scripts/data-service/benchmark-vector-index.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .orynode"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^1.0.3",
    "@octokit/rest": "^21.1.1",
    "@xenova/transformers": "^2.17.2",
    "jsdom": "^26.1.0",
    "next": "^16.2.12",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
