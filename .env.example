# TurboFieldfare 推理服务地址
TURBO_FIELDFARE_URL=http://127.0.0.1:8080/v1

# 本地数据服务地址 (SQLite + HTTP)
ORYNODE_DATA_URL=http://127.0.0.1:4318

# 本地数据库路径 (可选)
# ORYNODE_DATABASE_PATH=.orynode/data/orynode.db

# 运行时设置路径 (可选)
# ORYNODE_SETTINGS_PATH=.orynode/runtime-settings.json

# 数据服务端口 (可选)
# ORYNODE_DATA_PORT=4318

# 语义向量检索（可选，默认关闭）
# 依赖已包含 @xenova/transformers；设为 1 后由本地 data-service 加载模型
# 修改后需重启 npm run local
# ORYNODE_SEMANTIC_SEARCH=0
