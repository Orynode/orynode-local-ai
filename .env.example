# TurboFieldfare 推理服务地址
TURBO_FIELDFARE_URL=http://127.0.0.1:8080/v1

# 本地数据服务地址 (SQLite + HTTP；仅 127.0.0.1)
ORYNODE_DATA_URL=http://127.0.0.1:4318
# 本机 Settings 直连配对管理时可选（默认与上相同）
# NEXT_PUBLIC_ORYNODE_DATA_URL=http://127.0.0.1:4318

# 本地数据库路径 (可选)
# ORYNODE_DATABASE_PATH=.orynode/data/orynode.db

# 运行时设置路径 (可选)
# ORYNODE_SETTINGS_PATH=.orynode/runtime-settings.json

# 数据服务端口 (可选)
# ORYNODE_DATA_PORT=4318

# 语义向量模型（主机资源开关，默认关闭）
# 用户策略看 Settings「知识检索档位」：Lite 仅关键词；Balanced/Quality 在本开关为 1 时才融合向量
# 依赖已包含 @xenova/transformers；设为 1 后由本地 data-service 加载模型
# 修改后需重启 npm run local
# ORYNODE_SEMANTIC_SEARCH=0

# Embedding artifact（运行时只加载一个；禁止与旧向量混用）
# 默认推荐：multilingual-e5-small（中英；384 维；query:/passage: 模板）
# 兼容基线：bge-small-zh-v1.5（旧索引/中文对照/回滚；512 维）
# 实验：bge-m3
# 切换模型后必须：重建 Vector IndexBuild → 校验维度 → 原子切换 active → 才可用新查询
# 未设置时默认 multilingual-e5-small
# ORYNODE_EMBEDDING_ARTIFACT=multilingual-e5-small
# ORYNODE_EMBEDDING_ARTIFACT=bge-small-zh-v1.5

# 访问模式（默认 local_only：Web 仅绑定 127.0.0.1）
# ORYNODE_ACCESS_MODE=local_only
#
# Trusted-LAN（绑定 0.0.0.0）：
#   ORYNODE_ACCESS_MODE=trusted_lan
#   在本机 http://127.0.0.1 打开设置生成配对码；局域网设备 POST /api/lan/pairing claim
#   Data Service / TurboFieldfare 仍只监听 127.0.0.1
#
# 无认证开发预览（不安全，勿当正式共享）：
#   ORYNODE_ACCESS_MODE=trusted_lan
#   ORYNODE_TRUSTED_LAN_UNSAFE=1
# ORYNODE_ACCESS_MODE=trusted_lan
# ORYNODE_TRUSTED_LAN_UNSAFE=1
#
# 若 Web 在反向代理后，才信任 X-Forwarded-For（默认不信任）：
# ORYNODE_TRUST_PROXY=1
